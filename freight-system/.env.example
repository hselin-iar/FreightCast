# Environment variables — copy to .env and fill in real values.
# NEVER commit .env to version control.

# ─── Database ───────────────────────────────────────────────────────────────
# PostgreSQL connection string (Render managed Postgres in production)
DATABASE_URL=postgresql://user:password@localhost:5432/freight_db

# ─── AIS & Vessel Tracking ───────────────────────────────────────────────────
# AIS stream WebSocket key (aisstream.io)
AISSTREAM_API_KEY=

# MyShipTracking API key (real vessel position snapshots — handoff Step 49G)
MYSHIPTRACKING_API_KEY=

# ─── Market Data ─────────────────────────────────────────────────────────────
# OilPriceAPI key (live VLSFO bunker feed — handoff Step 50A)
OILPRICEAPI_API_KEY=

# ─── LLM Provider (chatbot tool-calling — server-side ONLY, NEVER expose to frontend) ─
# Priority: GROQ → NVIDIA → ANTHROPIC → OPENAI
# Set exactly ONE of these; the /chat route auto-detects which one is configured.

# Groq (ultra-fast, free tier available — recommended for dev)
# Models: llama-3.3-70b-versatile (default), mixtral-8x7b-32768
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Nvidia NIM (hosted Llama, pay-per-token)
# Models: meta/llama-3.3-70b-instruct (default)
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Anthropic Claude (claude-3-5-sonnet-20241022 default)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# OpenAI (gpt-4o default)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ─── Frontend (baked in at build time by Vite) ────────────────────────────────
# IMPORTANT: set this to your Render web service URL before deploying!
# NEVER put LLM keys here — this value ends up in the browser bundle.
VITE_API_BASE_URL=http://localhost:8000
